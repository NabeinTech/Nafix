# Sprint 13 — variables d'environnement du futur process API SaaS.
# Copiez ce fichier en .env (jamais commité) une fois l'API réellement
# démarrée (Sprint 15+). N'affecte en rien le mode Desktop, qui continue de
# lire config/db.config.json via config/paths.js.

# Connexion PostgreSQL — soit une URL complète, soit les variables PG* séparées.
# db/pool.js utilise DATABASE_URL en priorité si elle est définie.
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nafix_db

# Alternative à DATABASE_URL, si préféré :
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=nafix_db

# Audit du 22/08/2026 — db/pool.js active TLS par défaut (rejectUnauthorized
# désactivé, cf. commentaire du fichier) pour DATABASE_URL/PGHOST. Mettre
# PGSSL=disable UNIQUEMENT si la base tourne en local (dev) ou sur un réseau
# strictement privé qui ne supporte pas TLS — jamais en production distante.
# PGSSL=disable

# Signature des tokens (Sprint 14) — jamais la même valeur qu'un exemple,
# jamais commitée avec une vraie valeur.
JWT_SECRET=

# Port d'écoute de l'API (Sprint 15+)
PORT=3001
